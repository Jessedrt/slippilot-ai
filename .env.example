NODE_ENV=development
PORT=3000
HOST=0.0.0.0

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

DATABASE_URL=postgresql://slippilot:slippilot@localhost:5432/slippilot
REDIS_URL=redis://localhost:6379

# Legacy AI_PROVIDER / AI_MODEL are not used for slip analysis.
# Gemini is used ONLY to read photos/screenshots when a key is present.
AI_PROVIDER=disabled
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=
VISION_MODEL=gemini-2.5-flash

SPORTS_PROVIDER=disabled
SPORTS_API_KEY=

# API-Sports backend integration. A previously exposed key must be rotated.
# Automatic analysis stays disabled until API-Sports and relevant competition
# rights holders confirm the intended betting-analysis/publication use in writing.
API_SPORTS_ENABLED=false
API_SPORTS_KEY=
API_SPORTS_COMMERCIAL_USE_APPROVED=false
API_SPORTS_FOOTBALL_ENABLED=false
API_SPORTS_BASKETBALL_TOTALS_ENABLED=false
API_SPORTS_TIMEOUT_MS=8000
API_SPORTS_MAX_RETRIES=2

# YDC is the sole provider for slip/text analysis and web research.
# Enable this after adding your existing YDC key in the project's environment settings.
YOU_API_ENABLED=false
YDC_API_KEY=
YDC_API_KEY_2=
YDC_API_KEY_3=
YDC_API_KEY_4=
YDC_API_KEY_5=
YDC_API_KEY_6=
YDC_API_KEY_7=
YDC_API_KEY_8=
YDC_API_KEY_9=
YDC_API_KEY_10=
YOU_SEARCH_ENABLED=true
YOU_RESEARCH_ENABLED=true
YOU_TIMEOUT_MS=60000
YOU_MAX_RESULTS=8
YOU_CACHE_TTL_MS=300000

SPORTYBET_PROVIDER_ENABLED=false
SPORTYBET_REGION=ng
SPORTYBET_API_BASE_URL=https://www.sportybet.com
SPORTYBET_TIMEOUT_MS=10000
SPORTYBET_MIN_INTERVAL_MS=350
SPORTYBET_MAX_CONCURRENCY=2
SPORTYBET_MAX_RETRIES=2
SPORTYBET_CACHE_TTL_MS=30000

LOG_LEVEL=info
ADMIN_SECRET=
