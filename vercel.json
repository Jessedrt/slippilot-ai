{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "routes": [
    { "src": "/", "dest": "/api" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/api" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  }
}
