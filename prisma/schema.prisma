generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sport {
  FOOTBALL
  BASKETBALL
  MIXED
}

enum RiskMode {
  CONSERVATIVE
  BALANCED
  AGGRESSIVE
}

enum SlipStatus {
  DRAFT
  APPROVED
  CODE_CREATED
  EXPIRED
  ARCHIVED
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model User {
  id            String         @id @default(cuid())
  telegramId    BigInt         @unique
  username      String?
  displayName   String?
  locale        String?
  preferences   Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  messages      Message[]
  analyses      Analysis[]
  slips         Slip[]
  bookingCodes  BookingCode[]
  subscriptions Subscription[]
  usageRecords  UsageRecord[]
  auditLogs     AuditLog[]
}

model Conversation {
  id                 String    @id @default(cuid())
  userId             String
  currentSlipId      String?
  recentAnalysis     Json?
  lastSport          Sport?
  lastFixture        String?
  lastMarketCategory String?
  preferences        Json?
  conversationState  Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages           Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  telegramId     BigInt?
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Fixture {
  id            String           @id @default(cuid())
  provider      String
  providerId    String
  sport         Sport
  league        String
  homeTeam      String
  awayTeam      String
  startsAt      DateTime
  status        String
  rawData       Json?
  lastUpdated   DateTime         @default(now())
  markets       MarketSnapshot[]
  analyses      Analysis[]
  selections    Selection[]
  researchSnapshots ResearchSnapshot[]

  @@unique([provider, providerId])
  @@index([sport, startsAt])
}

model MarketSnapshot {
  id                  String   @id @default(cuid())
  fixtureId           String
  provider             String
  providerMarketId     String
  providerSelectionId  String
  category              String
  marketName            String
  selectionName         String
  odds                  Decimal  @db.Decimal(12, 4)
  line                  Decimal? @db.Decimal(12, 4)
  status                String
  capturedAt            DateTime @default(now())
  fixture               Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@index([fixtureId, capturedAt])
  @@index([provider, providerMarketId, providerSelectionId])
}

model Analysis {
  id                String    @id @default(cuid())
  userId            String
  fixtureId         String
  modelProbability  Decimal   @db.Decimal(5, 2)
  confidenceScore   Decimal   @db.Decimal(4, 2)
  dataQuality       String
  riskLevel         String
  reasoning         Json
  model             String
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fixture           Fixture   @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  selections        Selection[]

  @@index([userId, createdAt])
}

model Selection {
  id                   String          @id @default(cuid())
  fixtureId            String
  analysisId           String?
  provider              String?
  providerMarketId      String?
  providerSelectionId   String?
  marketName            String
  selectionName         String
  odds                  Decimal         @db.Decimal(12, 4)
  line                  Decimal?        @db.Decimal(12, 4)
  modelProbability      Decimal         @db.Decimal(5, 2)
  confidenceScore       Decimal         @db.Decimal(4, 2)
  dataQuality           String
  riskLevel             String
  status                String
  createdAt             DateTime        @default(now())
  fixture               Fixture        @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  analysis              Analysis?       @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  slipSelections        SlipSelection[]
}

model Slip {
  id             String          @id @default(cuid())
  userId         String
  sport          Sport
  targetOdds     Decimal?        @db.Decimal(12, 4)
  currentOdds    Decimal         @db.Decimal(12, 4)
  riskMode       RiskMode
  status         SlipStatus      @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  selections     SlipSelection[]
  bookingCodes   BookingCode[]

  @@index([userId, updatedAt])
}

model SlipSelection {
  id          String    @id @default(cuid())
  slipId      String
  selectionId String
  position    Int
  addedAt     DateTime  @default(now())
  slip        Slip      @relation(fields: [slipId], references: [id], onDelete: Cascade)
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Restrict)

  @@unique([slipId, selectionId])
  @@unique([slipId, position])
}

model BookingCode {
  id             String   @id @default(cuid())
  userId         String
  slipId         String
  provider       String
  code           String
  oddsAtCreation Decimal  @db.Decimal(12, 4)
  createdAt      DateTime @default(now())
  expiresAt      DateTime?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slip           Slip     @relation(fields: [slipId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@unique([provider, code])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  plan                   SubscriptionPlan
  status                 SubscriptionStatus
  paymentProvider        String?
  externalSubscriptionId String?
  startsAt               DateTime           @default(now())
  endsAt                 DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model UsageRecord {
  id         String   @id @default(cuid())
  userId     String
  feature    String
  units      Int      @default(1)
  metadata   Json?
  occurredAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, feature, occurredAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([userId, createdAt])
}

model ResearchSnapshot {
  id          String           @id @default(cuid())
  fixtureId   String
  query       String
  summary     String
  freshness   String
  confidence  Decimal          @db.Decimal(5, 2)
  searchedAt  DateTime
  createdAt   DateTime         @default(now())
  rawMetadata Json?
  fixture     Fixture          @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  sources     ResearchSource[]

  @@index([fixtureId, searchedAt])
}

model ResearchSource {
  id                 String           @id @default(cuid())
  researchSnapshotId String
  sourceTitle        String
  sourceUrl          String
  publisher          String
  publishedAt        DateTime?
  retrievedAt        DateTime         @default(now())
  confidence         Decimal          @db.Decimal(5, 2)
  rawMetadata        Json?
  researchSnapshot   ResearchSnapshot @relation(fields: [researchSnapshotId], references: [id], onDelete: Cascade)

  @@index([researchSnapshotId])
  @@index([sourceUrl])
}
